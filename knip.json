{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/index.ts"],
  "project": ["src/**/*.{ts,vue}"],
  // 模块内自用的语义导出（如 dice.ts 的 marginDegree/DEGREE_*、cards.ts 的 matchTrigger 等）
  // 不报「未使用导出」：它们刻意 export 保持单一事实源边界，仅在定义文件内消费
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    // klona/pinia 由 vite.config.ts 的 unplugin-auto-import 全局注入（无需源码 import），
    // knip 无法追踪 unplugin 配置，实际消费方遍布全库（klona(...) / defineStore(...) 等）
    "klona",
    "pinia",
    // toastr 由酒馆以全局变量提供（vite.config.ts externals 外置为 toastr），
    // 非 npm 依赖：import toastr from 'toastr' 直接取全局对象
    "toastr"
  ]
}